{
  "name": "grocery-cart",
  "private": true,
  "version": "0.0.1",
  "description": "Grocery Cart: turn a grocery list into a JioMart cart in your own logged-in Chrome.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "record": "tsx src/research/record.ts",
    "summarize": "tsx src/research/summarize.ts",
    "probe": "tsx src/research/probe.ts",
    "cart-probe": "tsx src/research/cart-probe.ts",
    "live-check": "tsx src/local/live-check.ts",
    "e2e": "vite build && tsx tests/e2e/phase0.e2e.ts && tsx tests/e2e/engine.e2e.ts && tsx tests/e2e/ui.e2e.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "start": "tsx src/local/server.ts"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "playwright-core": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  }
}
