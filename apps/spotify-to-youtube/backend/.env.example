# Max tracks converted per playlist.
MAX_TRACKS=500
# Parallel YouTube searches (keep low to stay polite / avoid throttling).
SEARCH_CONCURRENCY=3
# Videos per anonymous watch_videos link (verified working with 3; YouTube historically caps at 50).
TEMP_LINK_CHUNK=50
# SQLite match cache.
CACHE_PATH=./data/cache.sqlite3
CACHE_TTL_DAYS=30
# Optional YouTube Music region (e.g. IN, US). Empty = YouTube's default.
YTMUSIC_LOCATION=

# "Save to my YouTube account" (optional). Google Cloud OAuth client of type
# "TVs and Limited Input devices", with the YouTube Data API v3 enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify web player's persisted-query hash for fetchPlaylist (auto-rediscovered by the browser fallback).
# SPOTIFY_FETCH_PLAYLIST_HASH=
ENABLE_BROWSER_FALLBACK=1
# CHROMIUM_EXECUTABLE=/path/to/chrome
JOB_TTL_SECONDS=14400
